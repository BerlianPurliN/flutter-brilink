rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Function ---
    function isRole(roleName) {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == roleName;
    }

// ---------------- Users collection ----------------
    match /users/{userId} {

      // --- READ ---
      allow get: if request.auth != null && request.auth.uid == userId; // Allow self-get
      allow list: if request.auth != null && request.query.resource.data.uid == request.auth.uid; // Allow self-list-by-uid

      allow get, list: if isRole('super_admin'); // Super admin full read

      // Allow Admin Agen to GET Kasir they manage (reading one Kasir doc directly)
      allow get: if isRole('admin_agen')
                  && resource.data.role == 'kasir'
                  && resource.data.managed_by == request.auth.uid;

      // ✅ --- ADD THIS RULE ---
      // Allow Admin Agen to LIST users WHERE 'managed_by' matches their UID
      allow list: if isRole('admin_agen')
                   && request.query.filters.size() == 1          // Check exactly one filter
                   && request.query.filters[0].field == 'managed_by' // Check filter field
                   && request.query.filters[0].value == request.auth.uid; // Check filter value
      // ✅ --- END OF ADDED RULE ---


      // --- WRITES --- (Keep as before)
      allow create: if isRole('super_admin');
      allow update: if request.auth != null && request.auth.uid == userId && !('role' in request.resource.data) && !('managed_by' in request.resource.data) && !('managed_kasir_ids' in request.resource.data);
      allow update: if isRole('super_admin');
      allow delete: if isRole('super_admin');
    }
    // (Keep the rest of your rules for transactions and subcollections the same)

    // ---------------- Transactions collection ----------------
    match /transactions/{transactionId} {
      
      // Kasir bisa membuat transaksinya sendiri
      allow create: if isRole('kasir') && request.resource.data.uid_user == request.auth.uid;
      
      // Kasir bisa membaca transaksinya sendiri
      allow read: if isRole('kasir') && resource.data.uid_user == request.auth.uid;

      // Admin Agen bisa membaca transaksi milik Kasir yang dia kelola
      allow read: if isRole('admin_agen') 
                  // Anda harus menambahkan 'uid_admin_agen' ke transactionData
                  && resource.data.uid_admin_agen == request.auth.uid; 
      
      // Super Admin bisa membaca/menulis semua
      allow read, write: if isRole('super_admin');
    }

    // ---------------- Subcollections (rekening, cash, dll) ----------------
    // {userId} di sini adalah ID Kasir
    match /users/{userId}/{subcollection}/{docId} {

      // Izinkan user (Kasir) untuk R/W/D penuh pada subcollection-nya sendiri
      allow read, write, create, delete: if request.auth != null && request.auth.uid == userId;

      // Super Admin bisa R/W/D penuh
      allow read, write, create, delete: if isRole('super_admin');
    }
  }
}